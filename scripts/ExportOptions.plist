<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for an App Store build, used by scripts/release-ios.sh.

  Lives here rather than in ios/, because ios/ is generated by prebuild and
  gitignored — anything written there is destroyed on the next run.
-->
<plist version="1.0">
<dict>
  <!--
    `app-store` is deprecated in current Xcode; `app-store-connect` is the
    replacement. Run `xcodebuild -help` and search for "method" to see the
    full list your installed Xcode accepts.
  -->
  <key>method</key>
  <string>app-store-connect</string>

  <!-- Read from the Apple Development certificate's OU field. Confirm it at
       developer.apple.com > Membership before a first submission. -->
  <key>teamID</key>
  <string>5U74YS7399</string>

  <key>signingStyle</key>
  <string>automatic</string>

  <!-- `export` writes a .ipa to disk for Transporter. Change to `upload` to
       send it straight to App Store Connect and skip Transporter entirely. -->
  <key>destination</key>
  <string>export</string>

  <!-- Ship dSYMs so App Store Connect can symbolicate crash reports. -->
  <key>uploadSymbols</key>
  <true/>

  <!--
    Must stay false. When true, Xcode rewrites the build number during export,
    so the .ipa no longer matches the `ios.buildNumber` in app.json and you
    cannot tell which source revision produced a given upload.
  -->
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
</dict>
</plist>
