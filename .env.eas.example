# Copy to .env.eas (gitignored) and paste a PERSONAL Expo access token.
# Create one at https://expo.dev/settings/access-tokens while signed in as
# your personal account — NOT the caitcommittee account.
#
# This keeps `eas` commands in this project on your personal account without
# changing the global `eas login` that your other project relies on.
EXPO_TOKEN="paste-your-personal-expo-access-token-here"
